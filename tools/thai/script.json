      {"ch": "-n", "sound": "n", "word": "กิน", "rom": "gin", "mean": "eat (live, mid → mid)", "tone": "mid"},
      {"ch": "-m", "sound": "m", "word": "ผม", "rom": "pǒm", "mean": "I (male); hair (live, high → rising)", "tone": "rising"},
      {"ch": "-y", "sound": "i", "word": "สวย", "rom": "sǔay", "mean": "beautiful (live, high → rising)", "tone": "rising"},
      {"ch": "-w", "sound": "o", "word": "ขาว", "rom": "kǎao", "mean": "white (live, high → rising)", "tone": "rising"},
